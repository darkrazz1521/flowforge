# Application
NODE_ENV=development

# API
API_PORT=3000

# Frontend
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://flowforge:flowforge@localhost:5432/flowforge

# Redis
REDIS_URL=redis://localhost:6379

# Authentication
JWT_ACCESS_SECRET=change-this-development-secret
JWT_REFRESH_SECRET=change-this-development-refresh-secret

# Logging
LOG_LEVEL=debug